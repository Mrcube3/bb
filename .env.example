PROMETHEUS_DB_PATH=./prometheus.db
PROMETHEUS_ASSETS=BTCUSDT,ETHUSDT,SOLUSDT
PROMETHEUS_HORIZONS=10m,15m,1h,4h,24h
PROMETHEUS_DEFAULT_HORIZON=10m
PROMETHEUS_LIST_INTERVAL_SECONDS=60
PROMETHEUS_MIN_REPUTATION_SAMPLE=20
PROMETHEUS_BASE_PRICE=0.01
PROMETHEUS_MIN_PRICE=0.005
PROMETHEUS_MAX_PRICE=0.05
PROMETHEUS_CURRENCY=USDC
PROMETHEUS_ENVIRONMENT=local
PROMETHEUS_BINANCE_BASE_URL=https://data-api.binance.vision
PROMETHEUS_FACILITATOR_URL=https://x402.org/facilitator
PROMETHEUS_X402_NETWORK=eip155:84532
PROMETHEUS_X402_ASSET=USDC
PROMETHEUS_X402_PAY_TO=
PROMETHEUS_X402_SCHEME=exact
PROMETHEUS_ENABLE_SCHEDULER=true
PROMETHEUS_AUTO_GENERATE=true
PROMETHEUS_MODEL_PROVIDER=PROMETHEUS_DETERMINISTIC
PROMETHEUS_MODEL_VERSION=signal-v1
PROMETHEUS_PROMPT_SCHEMA_VERSION=prompt-v1
PROMETHEUS_QUANT_FORMULA_VERSION=quant-v1
PROMETHEUS_OUTCOME_METHOD_VERSION=outcome-v1
PROMETHEUS_PRICING_VERSION=price-v1
